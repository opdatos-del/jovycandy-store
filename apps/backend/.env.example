# Local Medusa configuration. Copy to .env and replace every placeholder.
# Never commit .env or use production credentials in this project.
NODE_ENV=development
DATABASE_URL=postgres://postgres:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:5432/jovycandy_prototipo_medusa
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:3000,http://localhost:9000
JWT_SECRET=GENERATE_A_UNIQUE_LOCAL_SECRET
COOKIE_SECRET=GENERATE_A_UNIQUE_LOCAL_SECRET
# URL pública con la que se sirven los archivos subidos por el File Module.
# Opcional: por defecto usa el puerto del servidor (`PORT`, 9000 si no se define).
# FILE_BACKEND_URL=http://localhost:9000/static

# Solo para el build local servido por HTTP. En HTTPS, eliminar o false.
# ADMIN_ALLOW_HTTP=true

# Correos (separados por coma) que reciben Superadministrador solo para el bootstrap inicial.
# Retirar después de asignar roles persistentes.
# JOVY_AUTHZ_BOOTSTRAP_EMAILS=admin@example.com
