# Local Medusa configuration. Copy to .env and replace every placeholder.
# Never commit .env or use production credentials in this project.
NODE_ENV=development
DATABASE_URL=postgres://postgres:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:5432/jovycandy_prototipo_medusa
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:3000,http://localhost:9000
JWT_SECRET=GENERATE_A_UNIQUE_LOCAL_SECRET
COOKIE_SECRET=GENERATE_A_UNIQUE_LOCAL_SECRET
