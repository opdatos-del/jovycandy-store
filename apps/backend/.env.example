# Configuración local de Medusa. Copiar a `.env` y sustituir cada placeholder.
# Nunca versionar `.env` ni usar credenciales de producción en este repositorio.
NODE_ENV=development
# Perfil de despliegue: development, staging o production. Si se omite se
# infiere de NODE_ENV. El preflight se ejecuta al arrancar; solo el build lo omite.
DEPLOYMENT_ENV=development
DATABASE_URL=postgres://postgres:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:5432/jovycandy_prototipo_medusa
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:3000,http://localhost:9000
JWT_SECRET=GENERATE_A_UNIQUE_LOCAL_SECRET
COOKIE_SECRET=GENERATE_A_UNIQUE_LOCAL_SECRET

# `shared` ejecuta API/Admin y worker; `server` solo API/Admin; `worker` solo workers.
WORKER_MODE=shared

# Desarrollo local usa el File Module local. No cambiar a S3 sin bucket, CORS,
# respaldo y credenciales aislados por entorno aprobados.
FILE_STORAGE_PROVIDER=local
# URL pública de archivos locales. Opcional: por defecto usa `PORT` (9000).
# FILE_BACKEND_URL=http://localhost:9000/static

# No establecer `ADMIN_ALLOW_HTTP=true`: se rechaza cuando NODE_ENV=production.

# Infraestructura Redis: inactiva por defecto para conservar desarrollo sin Redis.
# Activar solo en una instancia Redis autorizada y segregada. Caching requiere
# MEDUSA_FF_CACHING=true en Medusa 2.22.6.
# MEDUSA_REDIS_ENABLED=true
# MEDUSA_FF_CACHING=true
# EVENTS_REDIS_URL=redis://REPLACE_WITH_EVENTS_REDIS
# WORKFLOW_REDIS_URL=redis://REPLACE_WITH_WORKFLOW_REDIS
# CACHE_REDIS_URL=redis://REPLACE_WITH_CACHE_REDIS
# LOCKING_REDIS_URL=redis://REPLACE_WITH_LOCKING_REDIS
# Sesiones de express-session en Redis. Es independiente de MEDUSA_REDIS_ENABLED
# y solo se usa para compartir sesiones entre instancias del servidor.
# SESSION_REDIS_URL=redis://REPLACE_WITH_SESSION_REDIS
# SESSION_REDIS_PREFIX=medusa:

# Storage S3-compatible. Activar FILE_STORAGE_PROVIDER=s3 solo con todos los
# valores siguientes; S3_FILE_URL no debe terminar en `/`.
# Los valores reales se cargan desde el gestor de secretos del entorno y nunca
# se escriben en este archivo. Las variables vacías hacen fallar el arranque
# de forma explícita cuando FILE_STORAGE_PROVIDER=s3.
# S3_FILE_URL=https://cdn.example.invalid/jovycandy-staging
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=REPLACE_WITH_REGION
# S3_BUCKET=REPLACE_WITH_BUCKET
# S3_ENDPOINT=https://REPLACE_WITH_S3_COMPATIBLE_ENDPOINT

# Excepción solo para el servidor de staging sin S3. Requiere volumen persistente
# y respaldo; se rechaza automáticamente con DEPLOYMENT_ENV=production.
# STAGING_ALLOW_LOCAL_STORAGE=true

# Revalidación CMS del storefront. Sin URL y secreto, la entrega queda inactiva
# y el storefront conserva su TTL. El secreto debe coincidir con
# JOVY_REVALIDATION_SECRET del storefront y nunca usa el prefijo NEXT_PUBLIC_.
# STOREFRONT_REVALIDATION_URL=https://shop.example.invalid/api/revalidate
# STOREFRONT_REVALIDATION_SECRET=
# STOREFRONT_REVALIDATION_TIMEOUT_MS=3000

# Observabilidad opt-in. Sin OTEL_ENABLED=true no se registra instrumentación.
# Solo el exporter de consola existe sin añadir una dependencia aprobada.
# OTEL_ENABLED=false
# OTEL_TRACES_EXPORTER=console
# OTEL_SERVICE_NAME=jovycandy-medusa

# El bootstrap de autorización ya no usa variables de entorno. Se ejecuta con:
#   pnpm --dir apps/backend exec medusa exec ./src/scripts/bootstrap-authz.ts -- --user-id=usr_...
# Solo funciona si aún no existe ningún Superadministrador.
# Stripe oficial: solo laboratorio aislado (DEPLOYMENT_ENV=development).
JOVY_STRIPE_SANDBOX_ENABLED=false
# STRIPE_API_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PAYMENT_METHOD_CONFIGURATION=
