{
  "name": "@dtc/backend",
  "version": "0.0.1",
  "description": "A starter for Medusa projects.",
  "author": "Medusa (https://medusajs.com)",
  "license": "MIT",
  "keywords": [
    "sqlite",
    "postgres",
    "typescript",
    "ecommerce",
    "headless",
    "medusa"
  ],
  "scripts": {
    "build": "medusa build",
    "start": "medusa start",
    "dev": "medusa develop",
    "lint": "medusa lint",
    "typecheck": "tsc --noEmit",
    "test:integration:http": "cross-env TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:http:contacts": "cross-env TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules node ./integration-tests/run-ephemeral-postgres.cjs -- node ./node_modules/jest/bin/jest.js integration-tests/http/contacts-rate-limit.spec.ts --silent=false --runInBand --forceExit",
    "test:integration:http:legacy-import": "cross-env TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules node ./integration-tests/run-ephemeral-postgres.cjs -- node ./node_modules/jest/bin/jest.js integration-tests/http/legacy-import-full-manifest.spec.ts --silent=false --runInBand --forceExit",
    "test:integration:http:ephemeral": "cross-env TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules node ./integration-tests/run-ephemeral-postgres.cjs -- node ./node_modules/jest/bin/jest.js --silent=false --runInBand --forceExit",
    "test:integration:modules:ephemeral": "cross-env TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules node ./integration-tests/run-ephemeral-postgres.cjs -- node ./node_modules/jest/bin/jest.js --silent=false --runInBand --forceExit",
    "test:integration:launcher": "node --test integration-tests/isolation-preflight.test.cjs integration-tests/verify-medusa-connection.test.cjs integration-tests/verify-integration-postgres.test.cjs integration-tests/ephemeral-postgres.test.cjs",
    "test:integration:modules": "cross-env TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:unit": "cross-env TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit",
    "test:e2e": "playwright test",
    "seed:catalog": "medusa exec ./src/scripts/seed-jovy-catalog.ts",
    "import:legacy": "medusa exec ./src/scripts/migrations/jovycandy-legacy/import-products.ts",
    "import:legacy:preview": "cross-env LEGACY_IMPORT_MODE=preview medusa exec ./src/scripts/migrations/jovycandy-legacy/import-products.ts",
    "import:legacy:apply": "cross-env LEGACY_IMPORT_MODE=apply medusa exec ./src/scripts/migrations/jovycandy-legacy/import-products.ts",
    "legacy:extract": "node --experimental-strip-types ./src/scripts/migrations/jovycandy-legacy/extract-manifest.ts",
    "legacy:verify-media": "node --experimental-strip-types ./src/scripts/migrations/jovycandy-legacy/verify-media.ts",
    "inventory:restore": "medusa exec ./src/scripts/restore-lab-inventory.ts",
    "seed:commerce": "medusa exec ./src/scripts/seed-commerce-lab.ts",
    "seed:campaign": "medusa exec ./src/scripts/seed-commerce-campaign.ts",
    "seed:card-hover": "medusa exec ./src/scripts/seed-card-hover-rings.ts"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "2.22.6",
    "@medusajs/admin-shared": "2.22.6",
    "@medusajs/caching": "2.22.6",
    "@medusajs/cli": "2.22.6",
    "@medusajs/dashboard": "2.22.6",
    "@medusajs/draft-order": "2.22.6",
    "@medusajs/framework": "2.22.6",
    "@medusajs/icons": "2.22.6",
    "@medusajs/medusa": "2.22.6",
    "@medusajs/ui": "4.2.13",
    "@tanstack/react-query": "5.107.1",
    "exceljs": "^4.4.0",
    "multer": "^2.5.0",
    "react-i18next": "13.5.0",
    "react-router-dom": "7.18.5",
    "sharp": "^0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@medusajs/eslint-plugin": "2.22.6",
    "@medusajs/test-utils": "2.22.6",
    "@playwright/test": "1.64.1",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "@typescript-eslint/typescript-estree": "8.72.2",
    "cross-env": "10.1.0",
    "eslint": "^9.39.5",
    "jest": "^30.5.2",
    "jiti": "^2.7.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.7",
    "yalc": "^1.0.0-pre.53"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "packageManager": "pnpm@11.17.0"
}
