# Public local configuration.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
# Publishable key: identifica el canal de venta y es pública por diseño.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_API_KEY=pk_replace_me
# Server-only overrides used by staging containers. `NEXT_PUBLIC_*` remains a
# local compatibility fallback and is not required in the runtime image.
SITE_URL=http://localhost:3000
MEDUSA_BACKEND_URL=http://localhost:9000
MEDUSA_PUBLISHABLE_API_KEY=pk_replace_me
# Secreto de servidor para firmar la cookie de confirmación de pedido.
JOVY_COMMERCE_SECRET=GENERATE_A_UNIQUE_LOCAL_SECRET
# Secreto compartido con Medusa para /api/revalidate. Solo servidor; nunca
# usar el prefijo NEXT_PUBLIC_. Sin este valor el endpoint responde 503.
JOVY_REVALIDATION_SECRET=
# Solo sandbox local. No colocar claves secretas de Stripe en storefront.
JOVY_STRIPE_SANDBOX_ENABLED=false
# STRIPE_PUBLISHABLE_KEY=
# JOVY_MANUAL_CHECKOUT_FOR_E2E lo habilita únicamente el runner de laboratorio.
